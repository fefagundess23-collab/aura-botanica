rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Default deny all
    match /{document=**} {
      allow read, write: if false;
    }

    // Helper functions
    function isValidId(id) {
      return id is string && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    function incoming() {
      return request.resource.data;
    }

    function existing() {
      return resource.data;
    }

    function isSignedIn() {
      return request.auth != null;
    }

    function isVerified() {
      return isSignedIn() && request.auth.token.email_verified == true;
    }

    function isAdmin() {
      return isVerified() && (
        request.auth.token.email == 'fe.fagundess23@gmail.com' ||
        request.auth.token.email == '154042@upf.br' ||
        exists(/databases/$(database)/documents/admins/$(request.auth.uid))
      );
    }

    function isValidProduct(data) {
      return data.keys().hasAll(['nome', 'descricao', 'preco', 'imagem', 'disponivel', 'createdAt', 'updatedAt']) &&
        data.keys().hasOnly(['nome', 'descricao', 'descricaoCurta', 'preco', 'imagem', 'disponivel', 'categoria', 'destaque', 'createdAt', 'updatedAt']) &&
        data.nome is string && data.nome.size() >= 2 && data.nome.size() <= 120 &&
        data.descricao is string && data.descricao.size() >= 5 && data.descricao.size() <= 3000 &&
        data.preco is number && data.preco >= 0 &&
        data.imagem is string && data.imagem.size() <= 2048 &&
        data.disponivel is bool &&
        (!('descricaoCurta' in data) || (data.descricaoCurta is string && data.descricaoCurta.size() <= 250)) &&
        (!('categoria' in data) || (data.categoria is string && data.categoria.size() <= 80)) &&
        (!('destaque' in data) || data.destaque is bool) &&
        data.createdAt is timestamp &&
        data.updatedAt is timestamp;
    }

    function isValidCategory(data) {
      return data.keys().hasAll(['nome', 'createdAt']) &&
        data.keys().hasOnly(['nome', 'createdAt']) &&
        data.nome is string && data.nome.size() >= 2 && data.nome.size() <= 60 &&
        data.createdAt is timestamp;
    }

    // Products catalog
    match /products/{productId} {
      allow read: if true;
      allow create: if isAdmin() &&
        isValidId(productId) &&
        isValidProduct(incoming()) &&
        incoming().createdAt == request.time &&
        incoming().updatedAt == request.time;
      allow update: if isAdmin() &&
        isValidId(productId) &&
        isValidProduct(incoming()) &&
        incoming().createdAt == existing().createdAt &&
        incoming().updatedAt == request.time;
      allow delete: if isAdmin() && isValidId(productId);
    }

    // Categories collection
    match /categories/{categoryId} {
      allow read: if true;
      allow create: if isAdmin() &&
        isValidId(categoryId) &&
        isValidCategory(incoming()) &&
        incoming().createdAt == request.time;
      allow update, delete: if false;
    }

    // Brand and store public settings (WhatsApp number, social links, brand name)
    match /settings/{settingId} {
      allow read: if true;
      allow create, update: if isAdmin() && isValidId(settingId);
      allow delete: if false;
    }

    // Admin whitelist
    match /admins/{adminUid} {
      allow read: if isSignedIn() && (request.auth.uid == adminUid || isAdmin());
      allow write: if isVerified() && (request.auth.token.email == 'fe.fagundess23@gmail.com' || request.auth.token.email == '154042@upf.br') && isValidId(adminUid);
    }
  }
}
